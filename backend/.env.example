# Local development defaults. Never commit the completed .env file.
# Generate a secret: node -e "console.log(require('node:crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
HOST=127.0.0.1
PORT=3001
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Open signup is for your local test only. Use invite in production.
REGISTRATION_MODE=open
INVITE_CODE=

TURSO_DATABASE_URL=file:./data/library.db
TURSO_AUTH_TOKEN=
STORAGE_DRIVER=local
LOCAL_STORAGE_PATH=./data/objects
MAX_UPLOAD_MB=64
STORAGE_QUOTA_MB=2048
AI_REQUESTS_PER_HOUR=60

# Optional Gemini features. Reading and writing work without AI.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Optional image-capable model; leave blank to disable generated artwork.
# Check model availability in your account before enabling.
GEMINI_COVER_MODEL=
GOOGLE_BOOKS_API_KEY=
# Set an application name and contact email for Open Library requests.
COVER_LOOKUP_USER_AGENT=ReadingRoom/2.0 (personal book library)

# Cloud deployment: STORAGE_DRIVER=r2 and a libsql:// database URL.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# Only set if running behind a trusted reverse proxy of known depth.
# TRUST_PROXY_HOPS=1
