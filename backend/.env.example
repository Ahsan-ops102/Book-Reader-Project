# Copy this file to .env and fill in your own values.
# .env is gitignored — never commit real keys.

# Port the backend listens on
PORT=3001

# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Which Gemini model to call. Check aistudio.google.com for the current
# free-tier model list — names change over time. gemini-2.5-flash is a
# solid free, fast default as of mid-2026.
GEMINI_MODEL=gemini-2.5-flash

# Leave BLANK for local development (no login screen).
# Set this to any password once you deploy publicly, so random people
# on the internet can't read/upload to your library.
APP_PASSWORD=

# Comma-separated list of origins allowed to call this API.
# Local dev default already covers the Vite dev server.
ALLOWED_ORIGINS=http://localhost:5173

# ── Turso (cloud SQLite) ──────────────────────────────────
# Get these from: turso db show <db-name> --url / turso db tokens create <db-name>
TURSO_DATABASE_URL=libsql://your-db-name.turso.io
TURSO_AUTH_TOKEN=your_turso_auth_token_here

# ── Cloudflare R2 (PDF file storage) ─────────────────────
# Get these from the Cloudflare dashboard → R2 → Manage API Tokens
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=pdf-reader-uploads
