# Copy this file to .env and fill in your own values.
# .env is gitignored — never commit real keys.

# Port the backend listens on
PORT=3001

# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Which Gemini model to call. Check aistudio.google.com for the current
# free-tier model list — names change over time. gemini-2.5-flash is a
# solid free, fast default as of mid-2026.
GEMINI_MODEL=gemini-3.5-flash

# Leave BLANK for local development (no login screen).
# Set this to any password once you deploy publicly, so random people
# on the internet can't read/upload to your library.
APP_PASSWORD=

# Comma-separated list of origins allowed to call this API.
# Local dev default already covers the Vite dev server.
ALLOWED_ORIGINS=http://localhost:5173
